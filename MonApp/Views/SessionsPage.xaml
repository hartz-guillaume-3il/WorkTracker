<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkTracker.MonApp.Views.SessionsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Sessions">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Ajouter"
            Clicked="OnAddSessionClicked"
            IconImageSource="{FontImageSource Glyph='+', FontFamily='OpenSansRegular', Color=White, Size=22}" />
    </ContentPage.ToolbarItems>

    <CollectionView x:Name="cvSessions" Margin="16">
        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,6"
                        Padding="16"
                        Stroke="{StaticResource Gray200}"
                        StrokeShape="RoundRectangle 8">

                    <Grid ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding StartFormatted}"
                                   FontSize="16"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource Primary}" />
                            <Label Text="{Binding Note}"
                                   FontSize="13"
                                   TextColor="{StaticResource Gray500}" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                BackgroundColor="{StaticResource Secondary}"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8"
                                Padding="10,6"
                                VerticalOptions="Center">

                            <Label Text="{Binding DurationFormatted}"
                                   TextColor="White"
                                   FontSize="15"
                                   FontAttributes="Bold" />
                        </Border>
                    </Grid>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>