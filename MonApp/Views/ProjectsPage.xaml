<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="WorkTracker.MonApp.Views.ProjectsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Projets">

    <ContentPage.ToolbarItems>
        <ToolbarItem
            Text="Ajouter"
            Clicked="OnAddClicked"
            IconImageSource="{FontImageSource Glyph='+', FontFamily='OpenSansRegular', Color=White, Size=22}" />
    </ContentPage.ToolbarItems>

    <CollectionView
        x:Name="cvProjets"
        Margin="16"
        SelectionMode="Single"
        SelectionChanged="OnProjectSelected">

        <CollectionView.ItemTemplate>
            <DataTemplate>
                <Border Margin="0,6" Padding="16" StrokeShape="RoundRectangle 8">
                    <VerticalStackLayout Spacing="6">
                        <Label
                            Text="{Binding Name}"
                            FontSize="18"
                            FontAttributes="Bold" />
                        <Label
                            Text="{Binding Description}"
                            FontSize="14" />
                    </VerticalStackLayout>
                </Border>
            </DataTemplate>
        </CollectionView.ItemTemplate>

    </CollectionView>
</ContentPage>